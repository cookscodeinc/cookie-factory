{
  "name": "cookie-factory-tooling",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.3"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{json,md,yaml,yml}\"",
    "lint:format": "prettier --check \"**/*.{json,md,yaml,yml}\"",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint-cli2.yml \"**/*.md\"",
    "lint:spelling": "cspell --no-progress --show-suggestions ."
  },
  "devDependencies": {
    "cspell": "10.5.2",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1"
  }
}
