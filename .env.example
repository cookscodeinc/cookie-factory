# Copy this file to .env and use the absolute parent directory containing every
# Cookiecutter checkout listed in cookiecutters.yml.
COOKIECUTTER_ROOT=/home/you/Documents/git_repo

# Set these when the host user is not UID/GID 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# CI can override this with a prebuilt image tag.
COOKIE_FACTORY_IMAGE=cookie-factory-toolchain:local
