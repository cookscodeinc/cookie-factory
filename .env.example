# Copy this file to .env and use absolute host paths.
GITHUB_DOCS_TEMPLATE_DIR=/home/you/Documents/git_repo/github-doc-cookiecutter

# Set these when the host user is not UID/GID 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# CI can override this with a prebuilt image tag.
COOKIE_FACTORY_IMAGE=cookie-factory-toolchain:local
